{
  "manifest_version": 3,
  "name": "Yandex Music Discord RPC",
  "version": "1.0",
  "description": "Sends current track info to Discord Rich Presence",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://music.yandex.ru/*",
    "https://*.music.yandex.ru/*",
    "https://music.yandex.com/*",
    "https://*.music.yandex.com/*",
    "https://music.yandex.by/*",
    "https://*.music.yandex.by/*",
    "https://music.yandex.kz/*",
    "https://*.music.yandex.kz/*",
    "https://music.yandex.uz/*",
    "https://*.music.yandex.uz/*",
    "https://music.yandex.com.tr/*",
    "https://*.music.yandex.com.tr/*",
    "https://music.yandex.am/*",
    "https://*.music.yandex.am/*",
    "https://music.yandex.az/*",
    "https://*.music.yandex.az/*",
    "https://music.yandex.kg/*",
    "https://*.music.yandex.kg/*",
    "https://music.yandex.ua/*",
    "https://*.music.yandex.ua/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://music.yandex.ru/*",
        "https://*.music.yandex.ru/*",
        "https://music.yandex.com/*",
        "https://*.music.yandex.com/*",
        "https://music.yandex.by/*",
        "https://*.music.yandex.by/*",
        "https://music.yandex.kz/*",
        "https://*.music.yandex.kz/*",
        "https://music.yandex.uz/*",
        "https://*.music.yandex.uz/*",
        "https://music.yandex.com.tr/*",
        "https://*.music.yandex.com.tr/*",
        "https://music.yandex.am/*",
        "https://*.music.yandex.am/*",
        "https://music.yandex.az/*",
        "https://*.music.yandex.az/*",
        "https://music.yandex.kg/*",
        "https://*.music.yandex.kg/*",
        "https://music.yandex.ua/*",
        "https://*.music.yandex.ua/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Yandex Music Discord RPC"
  },
  "web_accessible_resources": []
}

